{
  "activation_policy": {
    "on_agent_seed_start": "must_check",
    "approval_gated_default_install_action": "must_offer_before_onboarding",
    "skip_reason_required_in_modes": [
      "ask-each-change",
      "agent-approve"
    ],
    "mode_policy": {
      "approval_gated_modes": [
        "ask-each-change",
        "agent-approve"
      ],
      "full_access": {
        "default_install_action": "must_install_and_verify_before_onboarding",
        "requires_user_approval": false,
        "allow_network": true,
        "allow_personal_or_global_writes": true,
        "authorize_declared_install_side_effects": true,
        "failure_action": "block_onboarding",
        "applies_to_default_installs": true
      }
    },
    "managed_target_policy": {
      "full_access": "replace-and-verify",
      "approval_gated": "ask-before-write",
      "personal_or_global_target_requires_explicit_request": true
    }
  },
  "bundled_skills": [
    {
      "name": "agent-seed-updater",
      "version": "v1.0.0",
      "kind": "multi-platform-direct-skill",
      "source_path": "bundled-skills/agent-seed-updater/skill",
      "purpose": "Check the installed Agent Seed release and its project-local managed skills once per conversation without running onboarding or repository scans.",
      "default_install": {
        "mode": "project-local",
        "offer_by_default": true,
        "required": true,
        "requires_user_approval_in_modes": [
          "ask-each-change",
          "agent-approve"
        ],
        "install_only_for_detected_or_requested_platforms": true
      },
      "post_install": {
        "action": "ensure-agent-seed-updater-startup-rule",
        "requires_user_approval_in_modes": [
          "ask-each-change",
          "agent-approve"
        ],
        "instruction_files": [
          "AGENTS.md",
          "CLAUDE.md"
        ]
      },
      "platforms": [
        {
          "platform": "codex",
          "target_path": "skills/agent-seed-updater",
          "overlay_path": "bundled-skills/agent-seed-updater/overlays/codex",
          "detection_paths": [
            ".codex",
            "skills"
          ],
          "verification": "SKILL.md exists at skills/agent-seed-updater/SKILL.md"
        },
        {
          "platform": "claude",
          "target_path": ".claude/skills/agent-seed-updater",
          "detection_paths": [
            ".claude",
            "CLAUDE.md"
          ],
          "verification": "SKILL.md exists at .claude/skills/agent-seed-updater/SKILL.md"
        },
        {
          "platform": "codeagent-cli",
          "target_path": ".cac/skills/agent-seed-updater",
          "detection_paths": [
            ".cac"
          ],
          "verification": "SKILL.md exists at .cac/skills/agent-seed-updater/SKILL.md"
        },
        {
          "platform": "opencode",
          "target_path": ".opencode/skills/agent-seed-updater",
          "detection_paths": [
            ".opencode",
            "opencode.json",
            ".opencode.yaml"
          ],
          "verification": "SKILL.md exists at .opencode/skills/agent-seed-updater/SKILL.md"
        }
      ],
      "writes": [
        "skills/agent-seed-updater",
        ".claude/skills/agent-seed-updater",
        ".cac/skills/agent-seed-updater",
        ".opencode/skills/agent-seed-updater"
      ]
    },
